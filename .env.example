# =============================================================================
# Copia questo file in `.env` e riempi i valori.
# `.env` è ignorato da git: nessuna chiave finisce nel repository.
# =============================================================================

# --- Database (obbligatorio) -------------------------------------------------
# Postgres locale, Supabase, Neon o qualunque Postgres gestito.
DATABASE_URL="postgresql://utente:password@localhost:5432/nomedb?schema=public"

# --- Sito (obbligatorio) -----------------------------------------------------
# Senza barra finale. In produzione è il dominio reale: canonical, sitemap e
# Open Graph si costruiscono da qui.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Chiave di firma delle sessioni admin. Generane una con:
#   openssl rand -base64 32
AUTH_SECRET=""

# --- Primo accesso admin -----------------------------------------------------
# Letti solo dallo script di seed per creare il primo utente.
# Cambia la password al primo accesso ed eliminale da qui.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# --- Indicizzazione ----------------------------------------------------------
# Finché è diverso da "true" il sito chiede ai motori di non indicizzare.
# Portalo a "true" solo al lancio.
NEXT_PUBLIC_ALLOW_INDEXING="false"

# --- Immagini caricate dall'amministrazione ----------------------------------
# Senza, i file finiscono sul disco in public/uploads: giusto in locale, ma su
# una piattaforma serverless spariscono al primo rilancio, e il caricamento
# viene rifiutato invece di perderli in silenzio. Su Vercel si crea da
# Storage → Create → Blob: la variabile viene collegata da sola.
BLOB_READ_WRITE_TOKEN=""

# --- Pagamenti (Fase 2) ------------------------------------------------------
# Senza queste variabili il checkout usa il provider "manual": l'ordine viene
# creato in stato pending e nessun pagamento viene richiesto.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Manutenzione programmata ------------------------------------------------
# Protegge /api/cron/manutenzione, che ogni notte libera le scorte impegnate da
# ordini mai pagati. NON e' opzionale: senza, un checkout abbandonato tiene la
# merce bloccata per sempre e il magazzino si esaurisce senza vendite.
# Generalo con: openssl rand -base64 32
CRON_SECRET=""

# --- Email transazionali (conferme d'ordine) ---------------------------------
# Senza queste, gli ordini vengono registrati SENZA email di conferma: il sito
# lo dichiara al cliente invece di fingere un invio, e l'area amministrativa
# permette di rimandarla a configurazione avvenuta.
# Serve sempre EMAIL_FROM, piu' UNA delle due chiavi.
EMAIL_FROM="ordini@tuodominio.it"
RESEND_API_KEY=""
# In alternativa a Resend:
# BREVO_API_KEY=""

# --- Newsletter (Fase 5) -----------------------------------------------------
# Uno solo dei tre. Senza, gli iscritti restano salvati nel database.
MAILCHIMP_API_KEY=""
MAILCHIMP_AUDIENCE_ID=""
BREVO_API_KEY=""
BREVO_LIST_ID=""
KLAVIYO_API_KEY=""
KLAVIYO_LIST_ID=""

# --- Analytics (Fase 5) ------------------------------------------------------
# Ogni script viene caricato solo se il rispettivo ID è valorizzato.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
GOOGLE_SITE_VERIFICATION=""
